NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api
LOG_LEVEL=debug
CORS_ORIGIN=*
SWAGGER_ENABLED=true
# Публичный https-адрес сервиса: ссылки-подписки /api/sub/<keyId>
# PUBLIC_URL=https://bot.example.com
# Админы: users.id (uuid из БД, не Telegram id) через запятую; свой id — команда /id
# ADMIN_USER_IDS=00000000-0000-4000-8000-000000000001,00000000-0000-4000-8000-000000000002

# Telegram
BOT_TOKEN=123456:replace-with-token-from-BotFather
# polling (dev) | webhook (prod)
BOT_MODE=polling
# Нужны только при BOT_MODE=webhook
# WEBHOOK_URL=https://bot.example.com/api/telegram/webhook
# WEBHOOK_SECRET=random_string_A-Za-z0-9_-

# Database (docker compose up -d db)
DATABASE_URL=postgres://xray:xray@localhost:5478/xray
DB_LOGGING=false

# Xray nodes: таймаут запроса к POST /commands xray-server-instance
XRAY_NODE_TIMEOUT_MS=8000

# Пополнение баланса через HUAYUN-vision/payments-service (без URL и ключа пополнение выключено).
# Ключ — из API_KEYS у payments-service (`project:key`) только часть после двоеточия;
# нужен ещё PUBLIC_URL (туда придёт callback). Адрес — https: на http сервис отвечает редиректом.
# PAYMENTS_URL=https://payments.example.com
# PAYMENTS_API_KEY=change-me-to-long-random-secret
# PAYMENTS_TIMEOUT_MS=15000
# Суммы на кнопках виджета; пусто — валюта не предлагается. RUB → YooKassa, CNY → WeChat Pay.
# TOPUP_PRESETS_RUB=100,300,500,1000
# TOPUP_PRESETS_CNY=10,30,50,100
# Диапазон своей суммы (пользователь вводит её сообщением)
# TOPUP_MIN_RUB=100
# TOPUP_MAX_RUB=100000
# TOPUP_MIN_CNY=10
# TOPUP_MAX_CNY=10000
